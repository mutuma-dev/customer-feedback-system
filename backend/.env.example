# Copy this file to ".env" and fill in your own values. The app reads ".env", never this file.

# ---- Database (your local PostgreSQL) ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/feedback

# ---- CORS: the URL the Next.js frontend runs on (comma separate for several) ----
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---- Detractor alerts: who is told when a customer is unhappy ----
# Use a REAL inbox you can open during the demo.
CARE_REP_EMAIL=care@example.com
# E.164 format, e.g. +254712345678. Leave empty to skip the SMS alert.
CARE_REP_PHONE=

# ---- Email (SMTP). Leave SMTP_HOST empty to only log emails to the console ----
# Gmail: turn on 2-Step Verification, then create an "app password" (16 characters).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com

# ---- Africa's Talking (sandbox). Leave AT_API_KEY empty to only log SMS ----
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ---- AI (smart reply drafts). Any OpenAI-compatible provider. Empty key = built-in template ----
# Free option: Groq (console.groq.com/keys)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=8
